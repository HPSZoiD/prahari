# ── Supabase project credentials (Dashboard → Project Settings → API) ─────────
# The anon key is public-safe: RLS + SECURITY DEFINER RPCs do the gating.
# NEVER put the service-role key here — it must never reach the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Local demo mode (optional) ─────────────────────────────────────────────────
# Set VITE_PRDH_DEMO=1 to run against an in-browser mock backend (no Supabase
# account needed — good for a first look and UI rehearsal). Prefer
# `npm run dev:demo` which loads .env.demo automatically. Do NOT set this on
# Netlify; production must always talk to real Supabase.
# VITE_PRDH_DEMO=1

# ── Prahari Assist (server-side only — set these in Netlify, never commit) ─────
# The Groq key is read only by netlify/functions/chat.mjs. It is NOT a VITE_
# variable and must never be exposed to the client bundle.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
